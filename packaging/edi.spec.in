Name:           edi
Version:        @VERSION@
Release:        1
Summary:        Markdown editor with live preview, code, Mermaid diagrams, and spreadsheets

License:        GPL-3.0-or-later
URL:            https://gitlab.com/mrdanpsmith/edi
BuildArch:      x86_64
Requires:       @REQUIRES@

# The shipped bundle is prebuilt (PyInstaller); rpmbuild must not try to
# generate or strip debug info from it, nor post-process it.
%global _debug_package 0
%global __os_install_post %{nil}
%global _build_id_links none
# The bundle carries its own Qt/PySide6 libraries. Automatic requires would
# turn every bundled soname into a dependency no repository provides; the
# real system dependencies are the explicit Requires above.
AutoReqProv:    no

%description
Edi is a markdown editor with a live preview, syntax-highlighted code
blocks, Mermaid diagram rendering, and spreadsheet-style tables with
formulas. It runs QtWebEngine in a native PySide6 window.

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}
cp -a %{_sourcedir}/usr %{buildroot}/

%files
/usr/bin/edi
/usr/lib/edi
/usr/share/applications/edi.desktop
/usr/share/icons/hicolor/*/apps/edi.png
/usr/share/doc/edi/copyright
/usr/share/doc/edi/README.md
