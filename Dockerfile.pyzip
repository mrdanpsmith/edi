# syntax=docker/dockerfile:1
#
# Builds the portable Edi bundle (a PyInstaller onedir: edi/edi plus
# edi/_internal) on Ubuntu 22.04 (glibc 2.35) so it also runs on older desktop
# Linux. Building on newer distros (e.g. Ubuntu 26.04, glibc 2.43) produces
# binaries that fail with "GLIBC_2.43 not found" on those machines.
#
#   docker build -f Dockerfile.pyzip -t edi-pyzip:jammy .
#   docker run --rm edi-pyzip:jammy | tar -C dist-app -x
#
# The bundle leaves the container as a tar stream, not through a bind mount,
# so the extracted tree belongs to the host user rather than root.
#
# The frontend is built in a pinned Node stage, so the host Node version is
# irrelevant.

# ---- Frontend build stage: builds dist/ with a pinned Node toolchain ----
FROM node:22-bookworm-slim AS frontend

WORKDIR /build

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json vite.config.ts index.html ./
COPY scripts/ scripts/
COPY src/ src/
COPY shared/ shared/
COPY tests/harness/ tests/harness/

RUN npm run build
# dist/ is now at /build/dist

# ---- Builder stage: PyInstaller onedir on glibc 2.35 ----
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    libpython3.10 \
    python3 \
    python3-venv \
    # Qt runtime deps: needed at build time so PyInstaller's Qt hooks can
    # resolve library info and collect platform plugins correctly.
    libegl1 \
    libgl1 \
    libglib2.0-0 \
    libdbus-1-3 \
    libfontconfig1 \
    libxkbcommon0 \
    libnss3 \
    libnspr4 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libxcb-cursor0 \
    libxcb-xkb1 \
    libxcb-icccm4 \
    libxcb-shape0 \
    libxcb-keysyms1 \
    libxcb-xinerama0 \
    libxcb-render-util0 \
    libxkbcommon-x11-0 \
    libxkbfile1 \
    libxtst6 \
    libxfixes3 \
    libkrb5-3 \
    libgssapi-krb5-2 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-build.txt ./
RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r requirements-build.txt

COPY --from=frontend /build/dist dist/
COPY backend/ backend/
COPY run_edi.py .
COPY edi.spec .
COPY scripts/assets/ scripts/assets/

RUN .venv/bin/pyinstaller --clean \
    --distpath dist-app \
    --workpath build \
    edi.spec

CMD ["tar", "-C", "/app/dist-app", "-c", "edi"]
