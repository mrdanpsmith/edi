# syntax=docker/dockerfile:1
#
# Builds a portable single-file Edi executable (PyInstaller onefile) on
# Ubuntu 22.04 (glibc 2.35) so the bundle also runs on older desktop Linux.
# Building on newer distros (e.g. Ubuntu 26.04, glibc 2.43) produces binaries
# that fail with "GLIBC_2.43 not found" on those machines.
#
#   docker build -f Dockerfile.pyzip -t edi-pyzip:jammy .
#   docker run --rm -v "$PWD/dist-app:/out" edi-pyzip:jammy
#
# The frontend is built in a pinned Node stage, so the host Node version is
# irrelevant.

# ---- Frontend build stage: builds dist/ with a pinned Node toolchain ----
FROM node:22-bookworm-slim AS frontend

WORKDIR /build

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json vite.config.ts index.html ./
COPY scripts/ scripts/
COPY src/ src/

RUN npm run build
# dist/ is now at /build/dist

# ---- Builder stage: PyInstaller onefile on glibc 2.35 ----
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    libpython3.10 \
    python3 \
    python3-venv \
    # Qt runtime deps: needed at build time so PyInstaller's Qt hooks can
    # resolve library info and collect platform plugins correctly.
    libegl1 \
    libgl1 \
    libglib2.0-0 \
    libdbus-1-3 \
    libfontconfig1 \
    libxkbcommon0 \
    libnss3 \
    libnspr4 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libxcb-cursor0 \
    libxcb-xkb1 \
    libxcb-icccm4 \
    libxcb-shape0 \
    libxcb-keysyms1 \
    libxcb-xinerama0 \
    libxcb-render-util0 \
    libxkbcommon-x11-0 \
    libxkbfile1 \
    libxtst6 \
    libxfixes3 \
    libkrb5-3 \
    libgssapi-krb5-2 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir \
        "PySide6==6.11.1" \
        "pyinstaller==6.22.0"

COPY --from=frontend /build/dist dist/
COPY backend/ backend/
COPY run_edi.py .
COPY edi.spec .
COPY scripts/assets/ scripts/assets/
COPY assets/ assets/

RUN PYINSTALLER_ZLIB_COMPRESSION_LEVEL=1 .venv/bin/pyinstaller --clean \
    --distpath dist-app \
    --workpath build \
    edi.spec

CMD ["cp", "/app/dist-app/edi", "/out/edi"]
