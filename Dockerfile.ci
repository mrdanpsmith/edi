# syntax=docker/dockerfile:1
#
# CI builder image: everything the check/test/build/package jobs need,
# preinstalled on Ubuntu 22.04 (glibc 2.35) so the PyInstaller onefile stays
# portable to older desktop Linux. Built+published by the `build-image` job
# (`.gitlab-ci.yml`) and referenced as `$CI_REGISTRY_IMAGE/edi-builder:jammy`.
#
#   docker build -f Dockerfile.ci -t edi-builder:jammy .
#
# Jobs link the baked venv into the checkout with `ln -s /opt/edi/venv .venv`.
# The venv is a read-only image layer: job scripts must NOT pip-install into it
# (rebuild the image instead, e.g. when requirements.txt changes).
#
# The runtime binary is built from this SAME glibc 2.35 base via Dockerfile.pyzip
# (an ubuntu:22.04 container), so the image does not itself produce artifacts.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Qt runtime deps (identical list to .gitlab-ci.yml's old .setup_full anchor),
# plus rpm/file for packaging, plus the toolchain bits used at job time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xz-utils ca-certificates git \
    python3 python3-venv libpython3.10 binutils rpm file \
    libegl1 libgl1 libglib2.0-0 libdbus-1-3 libfontconfig1 \
    libxkbcommon0 libnss3 libnspr4 libxcomposite1 libxdamage1 libxrandr2 \
    libgbm1 libasound2 libxcb-cursor0 libxkbcommon-x11-0 libxcb-xkb1 \
    libxcb-icccm4 libxcb-shape0 libxcb-keysyms1 libxcb-xinerama0 \
    libxcb-render-util0 libxkbfile1 libxtst6 libxfixes3 libkrb5-3 \
    libgssapi-krb5-2 fonts-dejavu-core \
    libpcsclite1 libpulse0 libwayland-cursor0 libwayland-egl1 \
    libwayland-server0 \
    libgl1-mesa-dri libegl-mesa0 libglx-mesa0 \
    && rm -rf /var/lib/apt/lists/*

# Node 22 as a static tarball (same major as the pinned Vite toolchain).
ARG NODE_VERSION=22.22.1
RUN curl -fsS "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
        | tar -xJ -C /usr/local --strip-components=1

# Python venv with everything the jobs need, pinned. Keep in sync with
# requirements.txt + the pyinstaller pin used by the old `build` job.
ARG PYSIDE6_VERSION=6.11.1
ARG PYINSTALLER_VERSION=6.22.0
RUN python3 -m venv /opt/edi/venv \
    && /opt/edi/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/edi/venv/bin/pip install --no-cache-dir \
        "PySide6==${PYSIDE6_VERSION}" \
        "pyinstaller==${PYINSTALLER_VERSION}" \
        pytest \
        pytest-qt

# Sanity: the whole point is that imports resolve at job time.
RUN /opt/edi/venv/bin/python -c \
        "import PySide6, PyInstaller, pytest, pytestqt; print('edi-builder OK', PySide6.__version__)"
