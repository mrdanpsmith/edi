# Builds the Edi AppImage on Ubuntu 22.04 (glibc 2.35) so the bundle runs on
# older desktop Linux systems. Building on newer distros produces bundles that
# require a matching, newer glibc (e.g. GLIBC_2.43 on Ubuntu 26.04).
#
# Used by scripts/build-appimage.sh. Build with:
#   docker build -f Dockerfile.appimage -t edi-appimage:jammy .
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    file \
    libayatana-appindicator3-dev \
    libgtk-3-dev \
    librsvg2-dev \
    libsoup-3.0-dev \
    libwebkit2gtk-4.1-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

# Node.js (jammy's distro node is too old for Vite). Matches the host toolchain.
ARG NODE_VERSION=v22.22.1
RUN curl -fsS https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.xz \
    | tar -xJ -C /usr/local --strip-components=1

WORKDIR /app
